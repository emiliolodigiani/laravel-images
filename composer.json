{
    "name": "emiliolodigiani/laravel-images",
    "description": "Responsive image resizing with srcset generation for Laravel",
    "keywords": ["laravel", "images", "responsive", "srcset", "webp", "resize"],
    "license": "MIT",
    "authors": [
        {
            "name": "Emilio Lodigiani",
            "email": "emilio@emiliolodigiani.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "intervention/image": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "EmilioLodigiani\\LaravelImages\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "EmilioLodigiani\\LaravelImages\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EmilioLodigiani\\LaravelImages\\ImageServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
